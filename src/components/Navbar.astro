---
/**
 * Barra de navegación.
 *
 * - Arranca TRANSPARENTE sobre el hero y se vuelve sólida al bajar el scroll.
 * - `nombreAlScrollear`: en la home el hero ya dice "REAL BETITS" en enorme, así
 *   que repetirlo en el navbar era ruido. Con esta opción el navbar arranca con
 *   SOLO el escudo y recupera el nombre cuando el hero queda atrás. Nunca se ve
 *   el nombre dos veces en el mismo vistazo, y nunca desaparece del todo.
 *   En páginas sin hero, el nombre se ve siempre.
 * - Los enlaces a secciones que todavía no existen van apagados con "pronto",
 *   para que el navbar se vea completo sin llevar a páginas vacías.
 * - En celular se abre un menú con el atributo `popover` de HTML (sin JS propio).
 * - `transition:persist` hace que el navbar NO se destruya al cambiar de página:
 *   por eso no parpadea con el fade. El precio es que la clase de "activo" que
 *   renderiza el servidor se queda pegada a la página donde entraste, así que el
 *   script de abajo la recalcula en cada navegación.
 */
import escudo from '../assets/escudo.webp';

interface Props {
  /** Ocultar el nombre mientras el hero esté en pantalla. */
  nombreAlScrollear?: boolean;
}
const { nombreAlScrollear = false } = Astro.props;

const enlaces = [
  { texto: 'Formación', href: '/', pronto: false },
  { texto: 'Partidos', href: '/partidos', pronto: false },
  { texto: 'Tabla', href: '/tabla', pronto: false },
  { texto: 'Galería', href: '/galeria', pronto: false },
];

const ruta = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const esActivo = (href: string) => ruta === href;
---

<header
  class:list={['navbar', { 'navbar--inicio': nombreAlScrollear }]}
  data-nombre-scroll={nombreAlScrollear ? '' : undefined}
  transition:persist="navbar"
>
  <div class="navbar__interior">
    <a class="navbar__marca" href="/">
      <img src={escudo.src} alt="" width="34" height="50" />
      <span class="navbar__nombre">Real Betits</span>
    </a>

    <!-- escritorio -->
    <nav class="navbar__links" aria-label="Secciones">
      {enlaces.map((e) =>
        e.pronto ? (
          <span class="navbar__link navbar__link--pronto" aria-disabled="true">
            {e.texto}<i>pronto</i>
          </span>
        ) : (
          <a
            class:list={['navbar__link', { 'navbar__link--activo': esActivo(e.href) }]}
            href={e.href}
            aria-current={esActivo(e.href) ? 'page' : undefined}
          >
            {e.texto}
          </a>
        )
      )}
    </nav>

    <!-- celular -->
    <button class="navbar__burger" popovertarget="menu-movil" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="menu-movil" popover class="navbar__menu">
    <nav aria-label="Secciones">
      {enlaces.map((e) =>
        e.pronto ? (
          <span class="navbar__menu-link navbar__link--pronto" aria-disabled="true">
            {e.texto}<i>pronto</i>
          </span>
        ) : (
          <a
            class:list={['navbar__menu-link', { 'navbar__link--activo': esActivo(e.href) }]}
            href={e.href}
            aria-current={esActivo(e.href) ? 'page' : undefined}
          >
            {e.texto}
          </a>
        )
      )}
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  /* estado sólido al bajar (la clase la pone el script de abajo) */
  .navbar--solida {
    background: rgb(3 17 10 / 0.82);
    border-bottom-color: rgb(195 147 80 / 0.28);
    backdrop-filter: blur(10px) saturate(1.2);
  }

  .navbar__interior {
    max-width: 1060px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .navbar__marca {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }
  .navbar__marca img {
    height: 40px;
    width: auto;
    filter: drop-shadow(0 3px 10px rgb(0 0 0 / 0.6));
  }

  .navbar__nombre {
    font-family: var(--fuente-display);
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blanco);
    white-space: nowrap;
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  /* Estado inicial de la home: solo el escudo, porque el hero ya dice el nombre
     en enorme. Se oculta con opacity (no con display) a propósito: así el hueco
     queda reservado y el navbar no se reacomoda cuando el nombre aparece. */
  .navbar--inicio .navbar__nombre {
    opacity: 0;
    transform: translateX(-8px);
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .navbar__link {
    position: relative;
    font-family: var(--fuente-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(229 225 222 / 0.72);
    padding: 6px 2px;
    transition: color 0.25s ease;
  }

  .navbar__link:hover { color: var(--blanco); }

  /* el subrayado dorado del link activo */
  .navbar__link--activo { color: var(--dorado-claro); }
  .navbar__link--activo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--dorado);
    border-radius: 2px;
  }

  /* enlaces apagados: se pueden ver, no se pueden clickear */
  .navbar__link--pronto {
    color: rgb(229 225 222 / 0.3);
    cursor: not-allowed;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }
  .navbar__link--pronto i {
    font-family: var(--fuente-texto);
    font-size: 9px;
    font-style: normal;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(195 147 80 / 0.6);
    border: 1px solid rgb(195 147 80 / 0.3);
    border-radius: 999px;
    padding: 1px 6px;
  }

  /* Al cambiar de página el navbar se reutiliza (transition:persist), así que sus
     cambios de estado se animarían como si fueran de scroll: medido, el nombre
     entraba deslizándose 8px durante 0.32s JUSTO con el fade de la página, y eso
     se ve como un tambaleo. Durante el cambio, estado instantáneo. */
  .navbar--sin-transicion,
  .navbar--sin-transicion .navbar__nombre,
  .navbar--sin-transicion .navbar__link,
  .navbar--sin-transicion .navbar__menu-link { transition: none; }

  /* ---------- celular ---------- */
  .navbar__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 38px;
    padding: 0 9px;
    background: transparent;
    border: 1px solid rgb(195 147 80 / 0.4);
    border-radius: 9px;
    cursor: pointer;
  }
  .navbar__burger span {
    display: block;
    height: 2px;
    background: var(--crema);
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  /* Con el menú abierto el ícono pasa a X. Es la señal de siempre, no un adorno:
     dice que el mismo botón ahora cierra. Las barras están a 7px entre centros
     (2px de barra + 5px de separación), así que se juntan con un desplazamiento
     de 7px antes de girar. */
  .navbar:has(.navbar__menu:popover-open) .navbar__burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .navbar:has(.navbar__menu:popover-open) .navbar__burger span:nth-child(2) { opacity: 0; }
  .navbar:has(.navbar__menu:popover-open) .navbar__burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar__menu {
    /* el popover vive en la capa superior: hay que ubicarlo a mano */
    position: fixed;
    inset: 62px 0 auto 0;
    margin: 0;
    width: 100%;
    border: 0;
    border-radius: 0;
    padding: 10px 24px 20px;
    background: rgb(4 22 13 / 0.97);
    border-bottom: 1px solid rgb(195 147 80 / 0.3);

    /* Abrir y cerrar: entra deslizándose desde arriba mientras aparece. La
       animación necesita `allow-discrete` en `display` y en `overlay`, porque son
       propiedades discretas: sin eso el navegador saca el popover de la capa
       superior en el mismo cuadro y no queda nada que animar. */
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 0.22s ease,
      transform 0.22s cubic-bezier(0.22, 0.85, 0.24, 1),
      display 0.22s allow-discrete,
      overlay 0.22s allow-discrete;
  }

  .navbar__menu:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  /* desde dónde arranca al abrir */
  @starting-style {
    .navbar__menu:popover-open {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  .navbar__menu:not(:popover-open) { display: none; }

  /* el velo, con la misma duración que el menú para que vayan juntos */
  .navbar__menu::backdrop {
    background: rgb(3 17 10 / 0.6);
    opacity: 1;
    transition:
      opacity 0.22s ease,
      display 0.22s allow-discrete,
      overlay 0.22s allow-discrete;
  }

  .navbar__menu:not(:popover-open)::backdrop { opacity: 0; }

  @starting-style {
    .navbar__menu:popover-open::backdrop { opacity: 0; }
  }

  .navbar__menu nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navbar__menu-link {
    font-family: var(--fuente-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(229 225 222 / 0.8);
    padding: 11px 4px;
    border-bottom: 1px solid rgb(195 147 80 / 0.12);
  }
  .navbar__menu-link.navbar__link--activo { color: var(--dorado-claro); }

  @media (max-width: 760px) {
    .navbar__links { display: none; }
    .navbar__burger { display: flex; }
  }
</style>

<script>
  /**
   * Lo ÚNICO con JavaScript del navbar: saber en qué punto del scroll está la
   * página. Son unas pocas líneas y no hay forma confiable de hacerlo en CSS
   * puro en todos los navegadores.
   *
   * Hace dos cosas:
   *   1. transparente -> sólida (a los 40px)
   *   2. ocultar/mostrar el nombre, para no repetirlo junto al hero
   *
   * Como el navbar es persistente entre páginas, el listener se registra una
   * sola vez y se reutiliza.
   */
  let enlazado = false;

  function revisarScroll() {
    const nav = document.querySelector('.navbar');
    if (!nav) return;

    nav.classList.toggle('navbar--solida', window.scrollY > 40);

    // El nombre solo se gestiona donde la página lo pidió (data-nombre-scroll).
    // Aparece cuando el hero ya quedó atrás del todo: así el nombre nunca se ve
    // dos veces en el mismo vistazo (hero + navbar). En páginas sin hero se ve
    // siempre, porque heroAtras queda en true.
    if (nav.hasAttribute('data-nombre-scroll')) {
      const hero = document.querySelector('.hero');
      const heroAtras = !hero || hero.getBoundingClientRect().bottom <= nav.offsetHeight;
      nav.classList.toggle('navbar--inicio', !heroAtras);
    }
  }

  /**
   * Marca cuál sección está activa.
   *
   * Hace falta en el cliente porque el navbar es persistente: la clase que
   * renderiza el servidor queda pegada a la página donde entraste. Medido:
   * entrando a /partidos con un clic desde la home, la URL cambiaba pero seguía
   * subrayado "Formación".
   *
   * Sin JavaScript no se pierde nada: no hay navegación en el cliente, y en una
   * carga normal el servidor ya dejó la clase correcta.
   */
  function marcarActivo() {
    // mismo cálculo que hace el servidor, para que no puedan discrepar
    const ruta = location.pathname.replace(/\/+$/, '') || '/';
    const enlaces = document.querySelectorAll('.navbar__link[href], .navbar__menu-link[href]');
    enlaces.forEach((a) => {
      const activo = a.getAttribute('href') === ruta;
      a.classList.toggle('navbar__link--activo', activo);
      if (activo) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  /**
   * Cierra el menú móvil.
   *
   * Hace falta porque el navbar se reutiliza entre páginas (transition:persist):
   * el popover es hijo del header, así que al cambiar de sección quedaba ABIERTO
   * sobre la página nueva. Se cierra al hacer clic en un enlace, y no solo al
   * llegar, porque la transición de Astro fotografía la página que se va: con el
   * menú abierto, aparecería en el fade.
   */
  function cerrarMenu() {
    const menu = document.getElementById('menu-movil');
    if (menu && menu.matches(':popover-open')) menu.hidePopover();
  }

  /** Se enlaza una sola vez, porque el popover también persiste. */
  function enlazarMenu() {
    const menu = document.getElementById('menu-movil');
    if (!menu || menu.dataset.enlazado) return;
    menu.dataset.enlazado = '1';
    menu.addEventListener('click', (ev) => {
      const destino = ev.target instanceof Element ? ev.target.closest('a[href]') : null;
      if (destino) menu.hidePopover();
    });
  }

  function iniciarNavbar() {
    // En un cambio de página, sin animaciones: el estado final se aplica de una.
    // Si no, el nombre se desliza y el fondo se desvanece mientras la página hace
    // el fade, y el conjunto se ve tambaleante. La animación queda para el scroll.
    const nav = document.querySelector('.navbar');
    if (nav) nav.classList.add('navbar--sin-transicion');

    revisarScroll();
    marcarActivo();
    enlazarMenu();
    cerrarMenu();

    if (nav) {
      // dos cuadros: uno para que el navegador registre el estado nuevo, otro
      // para devolver la transición. Con uno solo alcanza para el mismo cuadro.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => nav.classList.remove('navbar--sin-transicion'))
      );
    }

    if (!enlazado) {
      window.addEventListener('scroll', revisarScroll, { passive: true });
      window.addEventListener('resize', revisarScroll, { passive: true });
      enlazado = true;
    }
  }

  iniciarNavbar();
  document.addEventListener('astro:page-load', iniciarNavbar);
</script>
