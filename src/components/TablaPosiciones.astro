---
/**
 * La tabla de posiciones, en el formato de toda la vida:
 *
 *     EQUIPO          PJ  G  E  P  GF  GC  DIF  PTS
 *     Real Betits      2  1  0  1   7   6   +1    3
 *
 * Por qué una tabla y no casillas con la palabra escrita: las siglas (PJ, G, E,
 * P…) son el idioma universal del fútbol y ocupan la mitad del ancho. "1 ganado"
 * se lee mal y ocupa mucho; "1" debajo de "G" se lee solo.
 *
 * SIN columna de posición (#): se probó y no aporta — en una tabla de una sola
 * fila el número de la izquierda no dice nada que el resto no diga. Y sin
 * `title` en las siglas: el tooltip nativo molesta al pasar el mouse.
 *
 * Es reutilizable a propósito: la campaña le pasa SOLO nuestra fila, y más
 * adelante la sección Tabla le pasa las 6 del grupo. Mismo componente.
 *
 * ⚠️ TRAMPA DE NOMBRES: acá `d` es EMPATADOS y `l` es PERDIDOS (es el formato de
 * Copa Fácil, como el fútbol inglés: win/draw/loss). En el fútbol hispano la `d`
 * suele leerse como "derrotas": si se mezclan, el balance sale con los números
 * invertidos. Verificar siempre contra un caso conocido antes de confiar.
 */
import type { FilaTabla } from '../lib/liga';
import { MI_EQUIPO } from '../lib/liga';
import { escudoPropio } from '../lib/escudos';

interface Props {
  filas: (FilaTabla & { grupo?: string })[];
  /** Mostrar nuestro escudo en nuestra fila. */
  conEscudo?: boolean;
}

const { filas, conEscudo = true } = Astro.props;

/** Las columnas numéricas, en orden. `k` es la clave en la fila. */
const COLUMNAS = ['pj', 'w', 'd', 'l', 'gf', 'ga', 'gd'] as const;
const SIGLAS: Record<(typeof COLUMNAS)[number], string> = {
  pj: 'PJ', w: 'G', d: 'E', l: 'P', gf: 'GF', ga: 'GC', gd: 'DIF',
};

const esMia = (f: FilaTabla) => f.equipo === MI_EQUIPO;
const conSigno = (n: number) => (n > 0 ? `+${n}` : String(n));
---

<div class="tabla-envoltura">
  <table class="tabla">
    <thead>
      <tr>
        <th class="tabla__eq" scope="col">Equipo</th>
        {COLUMNAS.map((k) => <th class="tabla__c" scope="col">{SIGLAS[k]}</th>)}
        <th class="tabla__c tabla__pts" scope="col">PTS</th>
      </tr>
    </thead>
    <tbody>
      {
        filas.map((f) => (
          <tr class:list={['tabla__fila', esMia(f) && 'tabla__fila--mia']}>
            <td class="tabla__eq">
              {esMia(f) && conEscudo && (
                <img class="tabla__escudo" src={escudoPropio} alt="" width="18" height="26" />
              )}
              {esMia(f) ? 'Real Betits' : f.equipo}
            </td>
            {COLUMNAS.map((k) => (
              <td class:list={['tabla__c', k === 'gd' && 'tabla__dif']}>
                {k === 'gd' ? conSigno(f.gd) : f[k]}
              </td>
            ))}
            <td class="tabla__c tabla__pts">{f.pts}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* la tabla puede ser más ancha que el celular: se desplaza sola */
  .tabla-envoltura {
    overflow-x: auto;
  }

  .tabla {
    width: 100%;
    border-collapse: collapse;
    /* los números alineados en columna, no bailando según el dígito */
    font-variant-numeric: tabular-nums;
  }

  .tabla th,
  .tabla td {
    padding: 11px 9px;
    white-space: nowrap;
  }

  .tabla thead th {
    padding-top: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgb(229 225 222 / 0.4);
    border-bottom: 1px solid rgb(229 225 222 / 0.14);
  }

  .tabla__c { text-align: center; }
  .tabla__eq { text-align: left; }

  .tabla__fila td {
    font-size: 14px;
    color: rgb(229 225 222 / 0.72);
    border-bottom: 1px solid rgb(229 225 222 / 0.06);
  }

  /* nuestra fila: fondo tenue, sin barras ni filetes de color */
  .tabla__fila--mia td {
    background: rgb(195 147 80 / 0.1);
    color: var(--blanco);
    font-weight: 600;
  }

  .tabla__escudo {
    width: 18px;
    height: 26px;
    object-fit: contain;
    vertical-align: -7px;
    margin-right: 8px;
  }

  .tabla__dif { color: rgb(229 225 222 / 0.5); }

  .tabla__pts {
    font-family: var(--fuente-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--dorado-claro);
  }

  .tabla__fila--mia .tabla__pts { font-size: 19px; }

  @media (max-width: 560px) {
    .tabla th,
    .tabla td { padding: 10px 6px; }
    .tabla__fila td { font-size: 13px; }
  }
</style>
