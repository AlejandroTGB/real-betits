---
/**
 * Cancha en perspectiva con orientación VERTICAL (arco propio abajo, como en
 * Ultimate Team), donde se apoyan las cartas.
 *
 * El truco de 3D:
 *   - El plano se inclina:            rotateX(46deg)
 *   - Cada carta se contrainclina:    rotateX(-46deg)
 *   - Con `transform-origin: bottom center` el pivote queda en el borde inferior
 *     de la carta, así que se "para" sobre el pasto en vez de hundirse.
 *
 * OJO 1: nada de translateY en las cartas. Un translateY las desplaza media
 *        altura y quedan colgando fuera del campo.
 * OJO 2: el translateX(-50%) es imprescindible: hace que `left` sea el CENTRO
 *        de la carta y no su esquina. Sin él, una carta al 83% se sale del campo.
 *
 * El tamaño de todo va atado a `--ancho-cancha`, así que la cancha escala
 * completa (cartas, perspectiva y sombras) cambiando solo esa medida.
 *
 * Para ubicar cada carta, el padre pasa un <div class="jugador" style="left:..;bottom:..">
 * con porcentajes relativos al campo.
 */
interface Props {
  /** Ancho de la cancha. Todo lo demás escala a partir de esto. */
  ancho?: string;
}
const { ancho = '860px' } = Astro.props;
---

<section class="cancha" style={`--ancho-cancha: ${ancho}`}>
  <div class="cancha__escena">
    <div class="cancha__plano">
      <!-- líneas del campo (vertical: 200 x 300) -->
      <svg class="cancha__lineas" viewBox="0 0 200 300" preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="rgba(229,225,222,0.30)" stroke-width="1.1">
          <rect x="5" y="5" width="190" height="290" />
          <line x1="5" y1="150" x2="195" y2="150" />
          <circle cx="100" cy="150" r="26" />
          <!-- área grande y chica: arriba -->
          <rect x="42" y="5" width="116" height="41" />
          <rect x="72" y="5" width="56" height="16" />
          <!-- área grande y chica: abajo -->
          <rect x="42" y="254" width="116" height="41" />
          <rect x="72" y="279" width="56" height="16" />
          <!-- semicírculos del área -->
          <path d="M 79 46 A 24 24 0 0 0 121 46" />
          <path d="M 79 254 A 24 24 0 0 1 121 254" />
          <!-- esquinas -->
          <path d="M 5 11 A 6 6 0 0 0 11 5" />
          <path d="M 195 11 A 6 6 0 0 1 189 5" />
          <path d="M 5 289 A 6 6 0 0 1 11 295" />
          <path d="M 195 289 A 6 6 0 0 0 189 295" />
        </g>
        <g fill="rgba(229,225,222,0.30)">
          <circle cx="100" cy="150" r="2" />
          <circle cx="100" cy="32" r="1.8" />
          <circle cx="100" cy="268" r="1.8" />
        </g>
      </svg>

      <div class="cancha__alineacion">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .cancha {
    width: 100%;
    max-width: var(--ancho-cancha);
    margin: 0 auto;
  }

  .cancha__escena {
    /* La perspectiva se deriva del ancho para que el ángulo se vea igual en
       cualquier tamaño: si fuera un valor fijo, al agrandar la cancha el efecto
       se aplanaría. */
    perspective: calc(var(--ancho-cancha) * 3.4);
    perspective-origin: 50% 6%;
    /* Las cartas sobresalen un poco por encima del campo al pararse */
    padding: 22px 0 14px;
  }

  .cancha__plano {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 10px;
    /* overflow visible: con hidden el 3D se aplana y las cartas se deforman */
    overflow: visible;
    transform: rotateX(46deg);
    transform-style: preserve-3d;

    /* Cancela el hueco que deja la rotación.
       Al inclinar el plano 46°, su caja PROYECTADA queda más chica que su caja
       de layout: medido, el pasto empezaba recién 176px más abajo (con 860px de
       ancho), dejando un vacío enorme entre el título y el campo.
       Se usa % y no px a propósito: los márgenes en % se calculan sobre el ANCHO
       del contenedor, así que el ajuste escala junto con --ancho-cancha en vez
       de romperse en celular (medido: 20px de resto en escritorio, 19px en
       celular — parejo).
       -24% y no más: pasando de ahí las cabezas de las cartas se salen por
       arriba del contenedor. Los 20px que quedan no se ven como vacío, porque
       es justo donde asoma la carta del delantero. */
    margin-top: -24%;
    background:
      repeating-linear-gradient(
        90deg,
        rgb(255 255 255 / 0.035) 0 7.14%,
        transparent 7.14% 14.28%
      ),
      radial-gradient(120% 80% at 50% 0%, #16573b 0%, #0a2a1a 55%, #04140c 100%);
    box-shadow:
      0 0 0 1px rgb(195 147 80 / 0.25),
      0 40px 70px -20px rgb(0 0 0 / 0.8);
  }

  .cancha__lineas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cancha__alineacion {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* Cada carta se para sobre el pasto. El padre solo define left/bottom.
     El translateX(-50%) hace que `left` sea el CENTRO de la carta y no su esquina:
     sin eso, una carta al 83% se sale por el borde derecho del campo. */
  .cancha__alineacion :global(.jugador) {
    position: absolute;
    width: 17%;
    transform-origin: bottom center;
    transform: translateX(-50%) rotateX(-46deg);
    /* preserve-3d para que la sombra de abajo pueda acostarse en el plano */
    transform-style: preserve-3d;
    /* OJO: se anima `width`, NO `transform: scale()`.
       Con scale, el navegador rasteriza el texto una vez y después estira el
       bitmap -> el texto se pixela. Con width, el layout se recalcula y el texto
       se vuelve a dibujar nítido. Como el interior de la carta está en `cqw`,
       agrandar el ancho escala todo proporcionalmente igual que un zoom. */
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Sombra de contacto: se acuesta sobre el pasto (por eso rota +46, que es
     exactamente lo que le devuelve la carta) y evita el efecto "calcomanía". */
  .cancha__alineacion :global(.jugador)::after {
    content: '';
    position: absolute;
    left: 46%;
    bottom: -2px;
    width: 130%;
    height: 38%;
    transform-origin: top center;
    transform: translateX(-50%) rotateX(46deg);
    background: radial-gradient(50% 50% at 50% 45%, rgb(0 0 0 / 0.6) 0%, transparent 72%);
    pointer-events: none;
  }

  /* Al pasar el mouse la carta crece de verdad (no se escala) y se pone delante.
     Ajustable desde la página con --zoom-carta. */
  .cancha__alineacion :global(.jugador:hover) {
    width: calc(17% * var(--zoom-carta, 1.45));
    z-index: 5;
  }

  /* La sombra también crece, para que se lea que la carta se despegó del pasto */
  .cancha__alineacion :global(.jugador:hover)::after {
    width: 165%;
    height: 46%;
    background: radial-gradient(50% 50% at 50% 45%, rgb(0 0 0 / 0.68) 0%, transparent 74%);
  }

</style>
