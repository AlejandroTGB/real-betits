---
/**
 * Molde de las páginas "de verdad" del sitio: Base + navbar + contenido + pie.
 *
 * Diferencia con Base.astro:
 *   Base  -> el documento HTML pelado (head, fuentes, fondo). Lo usan también
 *            las páginas de trabajo (/cancha, /estilo).
 *   Sitio -> Base + la navegación del sitio + el router de transiciones.
 *
 * El <ClientRouter /> es lo que hace el fade entre páginas. Cuesta unos pocos
 * KB de JavaScript y a cambio:
 *   - el fade funciona también en navegadores viejos (con fallback),
 *   - el navbar no se re-dibuja en cada cambio (transition:persist).
 * La alternativa 100% CSS existe (`@view-transition`), pero solo funciona en
 * navegadores recientes; ahí se degrada a un cambio instantáneo.
 */
import { ClientRouter } from 'astro:transitions';
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /**
   * Pasa al navbar: ocultar el nombre mientras el hero esté en pantalla.
   * Lo usa la home, donde el hero ya dice el nombre en enorme.
   */
  nombreAlScrollear?: boolean;
}
const { titulo, descripcion, nombreAlScrollear = false } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion}>
  <ClientRouter slot="head" />

  <Navbar nombreAlScrollear={nombreAlScrollear} />

  <main transition:animate="fade">
    <slot />
  </main>

  <footer class="pie">
    <p>
      Real Betits · Zapping Liga Premier, Sábado 2° DIV
      <span>·</span> Datos de la liga vía Copa Fácil
      <span>·</span>
      <a class="pie__enlace" href="https://github.com/AlejandroTGB/real-betits" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>GitHub
      </a>
      <span>·</span>
      <a class="pie__enlace" href="https://www.instagram.com/real_betits/" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 100-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
        </svg>@real_betits
      </a>
    </p>
  </footer>
</Base>

<style>
  .pie {
    margin-top: 40px;
    padding: 26px 24px 34px;
    border-top: 1px solid rgb(195 147 80 / 0.18);
    text-align: center;
  }

  .pie p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: rgb(229 225 222 / 0.42);
  }

  .pie span { color: rgb(195 147 80 / 0.45); margin: 0 5px; }

  /* Los dos enlaces del pie: ícono + texto en el dorado del sitio.
     El ícono va con currentColor, así que hereda color y hover sin reglas extra. */
  .pie__enlace {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgb(195 147 80 / 0.78);
    text-decoration: none;
  }

  .pie__enlace svg { flex: none; }

  .pie__enlace:hover,
  .pie__enlace:focus-visible {
    color: rgb(227 189 130);
    text-decoration: underline;
  }
</style>
