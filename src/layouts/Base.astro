---
import '../styles/global.css';
import '../styles/fuentes.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Real Betits — Zapping Liga Premier' } = Astro.props;

/* URL absoluta de esta página, armada con `site` de astro.config.mjs. El dominio
   no se escribe a mano acá: si algún día cambia, cambia en un solo lugar. */
const url = new URL(Astro.url.pathname, Astro.site).href;

/* Imagen de la vista previa al compartir. Es FIJA a propósito: WhatsApp,
   Instagram y X la cachean durante semanas, así que no puede llevar datos que
   cambien (el próximo partido, el marcador, la posición en la tabla). Se
   regenera con scripts/vista-previa.html. */
const VISTA_PREVIA = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/escudo.png" />
    {/* Las fuentes las sirve el propio sitio (public/fuentes/), así que ya no hay
        preconnect ni hoja de estilos ajena bloqueando el pintado. Se precargan
        solo las dos que definen la primera pintada: el display de los títulos y
        el texto del cuerpo. Los demás pesos llegan cuando hacen falta. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fuentes/barlow-condensed-700.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fuentes/inter-400.woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    {/* Vista previa al compartir el link (WhatsApp, Instagram, X, LinkedIn).
        Sin esto, el link sale como una URL pelada y no como una tarjeta. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Real Betits" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={VISTA_PREVIA} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Escudo de Real Betits con el nombre del equipo, la liga y la dirección del sitio"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={VISTA_PREVIA} />
    {/* Slot con nombre: las páginas pueden inyectar cosas acá (ej: el router
        de transiciones). Si nadie pone nada, no pasa nada. */}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
